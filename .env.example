# Copy to your host's environment settings (not needed for a quick local try-out)
PORT=3000
DATABASE_FILE=./data/la360.db               # photos are stored in a "photos" folder next to it
BASE_URL=https://app.example.com            # your public web address (used in invite links and for secure cookies)
ADMIN_EMAIL=you@example.com                 # first start only: the head coach's sign-in email
ADMIN_NAME=Your Name                        # first start only
ADMIN_PASSWORD=choose-a-long-password       # first start only
# Email (invites and password resets). Without these, invite links are shown on screen to copy and send yourself.
# RESEND_API_KEY=re_...                     # or POSTMARK_TOKEN=...
# MAIL_FROM=Life Audit 360 <hello@yourdomain.com>
# SEED_DEMO=1                               # first start only: add sample coaches, participants and videos
